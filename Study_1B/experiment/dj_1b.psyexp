    <LoopTerminator name="Q1_3_trials"/>
    <Routine name="trial4"/>
    <LoopTerminator name="trials_loop"/>
    <Routine name="over"/>
    <LoopTerminator name="blocks"/>
  </Flow>
</PsychoPy2experiment>
