  <Flow>
    <Routine name="practice"/>
    <LoopInitiator loopType="TrialHandler" name="practice_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'numA': '##', 'numB': '##', 'changeA': '##', 'changeB': '##', 'playerC': '##', 'delaytime_prac': '##', 'symbol': 'changeup.png', 'cr': 'change.png', 'anumA': '####', 'anumB': '####', 'anumC': '####', 'posi_X': [0.4, 0.35], 'posi_rect': [0.2, 0.35]}, {'numA': '##', 'numB': '##', 'changeA': '##', 'changeB': '##', 'playerC': '##', 'delaytime_prac': '##', 'symbol': 'sameorange.png', 'cr': 'remain.png', 'anumA': '####', 'anumB': '####', 'anumC': '####', 'posi_X': [-0.4, 0.35], 'posi_rect': [-0.2, 0.35]}]" valType="str"/>
