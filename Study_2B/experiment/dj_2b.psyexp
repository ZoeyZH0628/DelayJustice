        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="store" updates="constant" val="last key" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="False" valType="bool"/>
        <Param name="syncScreenRefresh" updates="constant" val="False" valType="bool"/>
      </KeyboardComponent>
      <CodeComponent name="code_4">
        <Param name="Before Experiment" updates="constant" val="# 定义 Q_LOOP、GN初始值为一个空字符串&amp;#10;Q_LOOP=&quot;&quot;&amp;#10;GN=&quot;&quot;" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="// 定义 Q_LOOP 变量&amp;#10;var Q_LOOP = &quot;&quot;;&amp;#10;// 定义 GN 变量&amp;#10;var GN = &quot;&quot;;" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="from random import uniform&amp;#10;# 生成范围在[0,6]之间的随机数&amp;#10;random_number = uniform(0, 6)&amp;#10;&amp;#10;&amp;#10;# 使用条件语句来设置 Q_LOOP 的值&amp;#10;if 0 &lt;= random_number &lt; 1:&amp;#10;    Q_LOOP = &quot;ABC&quot;&amp;#10;elif 1 &lt;= random_number &lt; 2:&amp;#10;    Q_LOOP = &quot;ACB&quot;&amp;#10;elif 2 &lt;= random_number &lt; 3:&amp;#10;    Q_LOOP = &quot;BAC&quot;&amp;#10;elif 3 &lt;= random_number &lt; 4:&amp;#10;    Q_LOOP = &quot;BCA&quot;&amp;#10;elif 4 &lt;= random_number &lt; 5:&amp;#10;    Q_LOOP = &quot;CAB&quot;&amp;#10;else:&amp;#10;    Q_LOOP = &quot;CBA&quot;&amp;#10;    &amp;#10;&amp;#10;# 使用条件语句根据随机数的大小设置 GN 变量的值&amp;#10;if random_number &lt;= 3:&amp;#10;    GN = &quot;A&quot;&amp;#10;else:&amp;#10;    GN = &quot;B&quot;&amp;#10;    &amp;#10;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="// 生成范围在 [0, 6] 之间的随机数&amp;#10;var random_number = Math.random() * 6; // Math.random() 返回 [0, 1) 之间的随机数，乘以 6 将其映射到 [0, 6) 之间&amp;#10;&amp;#10;&amp;#10;&amp;#10;// 使用条件语句来设置 Q_LOOP 的值&amp;#10;if (0 &lt;= random_number &amp;&amp; random_number &lt; 1) {&amp;#10;    Q_LOOP = &quot;ABC&quot;;&amp;#10;} else if (1 &lt;= random_number &amp;&amp; random_number &lt; 2) {&amp;#10;    Q_LOOP = &quot;ACB&quot;;&amp;#10;} else if (2 &lt;= random_number &amp;&amp; random_number &lt; 3) {&amp;#10;    Q_LOOP = &quot;BAC&quot;;&amp;#10;} else if (3 &lt;= random_number &amp;&amp; random_number &lt; 4) {&amp;#10;    Q_LOOP = &quot;BCA&quot;;&amp;#10;} else if (4 &lt;= random_number &amp;&amp; random_number &lt; 5) {&amp;#10;    Q_LOOP = &quot;CAB&quot;;&amp;#10;} else {&amp;#10;    Q_LOOP = &quot;CBA&quot;;&amp;#10;}&amp;#10;&amp;#10;&amp;#10;// 使用条件语句根据随机数的大小设置 GN 变量的值&amp;#10;if (random_number &lt;= 3) {&amp;#10;    GN = &quot;A&quot;;&amp;#10;} else {&amp;#10;    GN = &quot;B&quot;;&amp;#10;}&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Both" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="code_4" valType="code"/>
      </CodeComponent>
    </Routine>
